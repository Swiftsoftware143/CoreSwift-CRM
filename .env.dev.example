# CRM Swift - Development Environment TEMPLATE
#
# This is the tracked dev-shape template. Copy it to `.env.dev` (or `.env`) and fill in real
# values locally:
#
#     cp .env.dev.example .env.dev
#
# `.env.dev` and `.env` are BOTH gitignored on purpose: no real environment file is published
# from this repository (the fleet's `tracked-secret-check.sh` gate refuses the whole push if one
# is). Only `*.example` / `*.sample` / `*.template` variants are allowlisted.
#
# On the VPS the real source of configuration is NOT this file:
#     /etc/swift/env/coreswift.env      <- the live values for the deployed crm-swift container
#     /etc/swift/env/<app>.env          <- same shape for the other fleet apps
# Read that file for anything running in production; this template only mirrors its KEY set.
#
# Hostnames below (`postgres`, `redis`) are the docker-compose service names — they resolve
# inside the compose network only. A process running on the host must use 127.0.0.1 instead.

# Server
APP_HOST=0.0.0.0
APP_PORT=8080

# Database (inside the compose network, use the service name)
# Shape: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://crm_swift:<password>@postgres:5432/crm_swift

# Cache — the live Redis requires auth; a dev Redis may be passwordless
REDIS_URL=redis://redis:6379
# REDIS_URL=redis://:<password>@<host>:6379

# Auth
# Generate with: openssl rand -hex 32   (the live key is 64 chars)
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=2592000

# Secrets at rest (CS-21) — tenant-supplied credentials (provider_keys.api_key, the Telnyx BYOK
# slot, private-email keys) are encrypted with a per-tenant key derived from this value. Writes
# FAIL CLOSED when it is missing. Generate with: openssl rand -hex 32  (>= 32 chars).
CORESWIFT_SECRET=

# Rate Limiting
AUTH_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=20

# Cache TTLs (seconds)
SCORE_CACHE_TTL=300
LIST_CACHE_TTL=120
SESSION_CACHE_TTL=3600

# Database Pool
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=20

# Logging
RUST_LOG=crm_swift=debug,info

# ---------------------------------------------------------------------------------------------
# Keys the live VPS config (/etc/swift/env/coreswift.env) declares that the old published dev
# fixture carried none of. Leave blank unless you exercise the feature locally.
# ---------------------------------------------------------------------------------------------

# Cross-app lead sync from the sister apps (FunnelSwift / missedcallrespondr) — inbound calls are
# rejected when this does not match the sender's key.
INTERNAL_SYNC_KEY=

# Outbound comms (per-tenant provider config is overridden via PATCH /api/comms/providers)
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Where this CRM points at the lead-capture app
FUNNELSWIFT_URL=
